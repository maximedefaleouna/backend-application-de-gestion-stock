// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
 
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum RoleUtilisateur {
  admin
  vendeur
}

enum ModePaiement {
  espece
  mobile_money
  carte
  credit
}

enum StatutVente {
  completee
  credit
  partielle
  annulee
}

enum TypeMouvementStock {
  entree
  sortie
  ajustement
}

enum TypeNotification {
  vente
  stock
  credit
  systeme
}

// Models
model Utilisateur {
  id        String   @id @default(uuid())
  nom       String
  prenom    String
  email     String   @unique
  motDePasse String
  telephone String
  indicatif String  @default("+228")
  role      RoleUtilisateur @default(vendeur)
  actif     Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("cree_le")
  derniereConnexion DateTime? @map("derniere_connexion")
  deleted   Boolean  @default(false)

  // Relations
  ventes     Vente[]
  mouvementsStock MouvementStock[]

  @@map("utilisateurs")
}

model Categorie {
  id          String    @id @default(uuid())
  nom         String    @unique
  description String?
  createdAt      DateTime  @default(now()) @map("cree_le")
  updatedAt   DateTime  @updatedAt @map("modifie_le")

  // Relations
  produits    Produit[]

  @@map("categories")
}


model Produit {
  id                 String   @id @default(uuid())
  nom                String
  reference          String   @unique
  description        String?
  categorieId        String   @map("categorie_id")
  marque             String
  prixVente          Decimal  @db.Decimal(10, 2) @map("prix_vente")
  stock              Int      @default(0)
  stockMin           Int      @default(5) @map("stock_min")
  imageUrl           String?  @map("image_url")
  disponible         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("cree_le")
  updatedAt   DateTime @updatedAt @map("modifie_le")

  // Relations
  categorie      Categorie        @relation(fields: [categorieId], references: [id])
  articlesVente  ArticleVente[]
  mouvementsStock MouvementStock[]

  @@map("produits")
}

model Client {
  id          String   @id @default(uuid())
  nom         String
  telephone   String
  indicatif   String   @default("+228")
  email       String?
  adresse     String?
  totalCredit Int  @default(0)  @map("total_credit")
  totalPaye   Int  @default(0)  @map("total_paye")
  createdAt      DateTime @default(now()) @map("cree_le")
  updatedAt   DateTime @updatedAt @map("modifie_le")

  // Relations
  ventes           Vente[]
  paiementsCredit  PaiementCredit[]

  @@map("clients")
}

model Vente {
  id              String        @id @default(uuid())
  venteNumber     Int           @unique @default(autoincrement()) @map("vente_number")
  montantTotal    Int        @map("montant_total")
  montantPaye     Int       @default(0)  @map("montant_paye")
  montantRestant  Int       @default(0)  @map("montant_restant")
  modePaiement    ModePaiement  @default(espece) @map("mode_paiement")
  statut          StatutVente   @default(completee)
  clientId        String?       @map("client_id")
  estCredit       Boolean       @default(false) @map("est_credit")
  vendeurId       String        @map("vendeur_id")
  createdAt      DateTime      @default(now()) @map("cree_le")
  updatedAt   DateTime      @updatedAt @map("modifie_le")

  // Relations
  client          Client?       @relation(fields: [clientId], references: [id])
  vendeur         Utilisateur   @relation(fields: [vendeurId], references: [id])
  articles        ArticleVente[]
  paiementsCredit PaiementCredit[]

  @@map("ventes")
}

model ArticleVente {
  id        String  @id @default(uuid())
  venteId   String  @map("vente_id")
  produitId String  @map("produit_id")
  quantite  Int
  prixUnitaire Int  @map("prix_unitaire")
  prixTotal Int  @map("prix_total")

  // Relations
  vente   Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)
  produit Produit @relation(fields: [produitId], references: [id])

  @@map("articles_vente")
}

model PaiementCredit {
  id            String        @id @default(uuid())
  clientId      String        @map("client_id")
  venteId       String        @map("vente_id")
  montant       Decimal       @db.Decimal(10, 2)
  modePaiement  ModePaiement  @default(espece) @map("mode_paiement")
  date          DateTime      @default(now())
  createdAt    DateTime      @default(now()) @map("cree_le")

  // Relations
  client Client @relation(fields: [clientId], references: [id])
  vente  Vente  @relation(fields: [venteId], references: [id])

  @@map("paiements_credit")
}

model MouvementStock {
  id        String            @id @default(uuid())
  produitId String            @map("produit_id")
  type      TypeMouvementStock
  quantite  Int
  motif     String
  utilisateurId String        @map("utilisateur_id")
  date      DateTime          @default(now())
  createdAt    DateTime          @default(now()) @map("cree_le")

  // Relations
  produit Produit @relation(fields: [produitId], references: [id])
  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@map("mouvements_stock")
}

model Notification {
  id        String           @id @default(uuid())
  type      TypeNotification
  titre     String
  message   String
  lu        Boolean          @default(false)
  utilisateurId String?      @map("utilisateur_id")
  createdAt    DateTime         @default(now()) @map("cree_le")

  @@map("notifications")
}


model Configuration {
  id        String  @id @default(uuid())
  nom       String
  nomChef   String
  prenomChef String
  adresse   String
  telephone String
  email     String

  @@map("configurations")
}
