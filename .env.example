# Port du serveur
PORT=3000

# Configuration de la base de donnees (PostgreSQL / Neon Serverless)
DATABASE_URL="postgresql://username:password@localhost:5432/gestion_stock?schema=public"

# Configuration JWT
JWT_SECRET=votre-cle-secrete-tres-securisee-changez-moi
